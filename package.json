{
  "name": "smallweb",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@smallweb/shared",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "format": "prettier --write .",
    "lint": "node scripts/run-in-workspaces.mjs lint",
    "typecheck": "node scripts/run-in-workspaces.mjs typecheck",
    "seed": "npm run seed --workspace=api"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
